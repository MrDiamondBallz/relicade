<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>Relicade</AssemblyName>
		<RootNamespace>Relicade</RootNamespace>
		<AssemblyTitle>Relicade</AssemblyTitle>
		<AssemblyDescription>Relicade — download and manage GitHub-hosted game ports</AssemblyDescription>
		<Version>0.1.0</Version>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>
		<Configurations>Debug;Release</Configurations>
		<Nullable>enable</Nullable>
		<!-- SDL3-CS passes gamepads as SDL_Gamepad* pointers (Services/InputService.cs). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>enable</ImplicitUsings>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')))">
		<DefineConstants>$(DefineConstants);OSX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RelicadeExcludeWindowsDrawing)' == 'true'">
		<DefineConstants>$(DefineConstants);EXCLUDE_WINDOWS_DRAWING</DefineConstants>
		<OutputPath>bin\android-ref\$(Configuration)\</OutputPath>
		<IntermediateOutputPath>obj\android-ref\$(Configuration)\</IntermediateOutputPath>
		<DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AsyncImageLoader.Avalonia" Version="3.8.0" />
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
		<PackageReference Include="SharpCompress" Version="0.50.1" />
		<PackageReference Include="System.Text.Json" Version="10.0.3" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.3" Condition="'$(RelicadeExcludeWindowsDrawing)' != 'true'" />
		<PackageReference Include="NAudio" Version="2.2.1" Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))" />
		<PackageReference Include="Velopack" Version="1.2.0" />
	</ItemGroup>

	<!-- No telemetry token or inherited collection endpoint is embedded. -->

	<ItemGroup>
		<AvaloniaResource Include="Assets/**" />
		<AvaloniaResource Include="Assets/Icons/**" />
	</ItemGroup>

	<ItemGroup>
		<None Update="icon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="lib\Relicade.Core\Relicade.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="lib\Relicade.Core\**\*.cs" />
		<Compile Remove="Relicade.Tests\**\*.cs" />
		<Compile Remove="Relicade.Desktop\**\*.cs" />
		<Compile Remove="Relicade.Android\**\*.cs" />
		<Compile Remove="Program.cs" />
        <Compile Remove="tools\**\*.cs" />
		<Compile Remove="_test_build\**\*.cs" />
		<Compile Remove="artifacts\**\*.cs" />
		<Compile Remove="bin\**\*.cs" />
		<Compile Remove="obj\**\*.cs" />
		<EmbeddedResource Remove="lib\Relicade.Core\**\*.*" />
		<EmbeddedResource Remove="Relicade.Tests\**\*.*" />
		<EmbeddedResource Remove="Relicade.Desktop\**\*.*" />
		<EmbeddedResource Remove="Relicade.Android\**\*.*" />
		<EmbeddedResource Remove="_test_build\**\*.*" />
		<EmbeddedResource Remove="artifacts\**\*.*" />
		<None Remove="lib\Relicade.Core\**\*.*" />
		<None Remove="Relicade.Tests\**\*.*" />
		<None Remove="Relicade.Desktop\**\*.*" />
		<None Remove="Relicade.Android\**\*.*" />
		<None Remove="_test_build\**\*.*" />
		<None Remove="artifacts\**\*.*" />
	</ItemGroup>
</Project>
