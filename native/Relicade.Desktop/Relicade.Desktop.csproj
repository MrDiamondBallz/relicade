<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ApplicationIcon>..\icon.ico</ApplicationIcon>
		<AssemblyName>Relicade.Desktop</AssemblyName>
		<RootNamespace>Relicade.Desktop</RootNamespace>
		<AssemblyTitle>Relicade</AssemblyTitle>
		<AssemblyDescription>Relicade — download and manage GitHub-hosted game ports</AssemblyDescription>
		<Version>0.1.0</Version>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')))">
		<DefineConstants>$(DefineConstants);OSX</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon.ico" Link="icon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Relicade.App.csproj" />
	</ItemGroup>

	<!-- AppHost can be renamed; it still loads Relicade.Desktop.dll. -->
	<Target Name="AliasRelicadeExe" AfterTargets="Build;Publish">
		<PropertyGroup>
			<_AliasDir Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(AssemblyName).exe')">$(PublishDir)</_AliasDir>
			<_AliasDir Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(AssemblyName)')">$(PublishDir)</_AliasDir>
			<_AliasDir Condition="'$(_AliasDir)' == ''">$(OutputPath)</_AliasDir>
		</PropertyGroup>
		<Copy SourceFiles="$(_AliasDir)$(AssemblyName).exe"
		      DestinationFiles="$(_AliasDir)Relicade.exe"
		      SkipUnchangedFiles="true"
		      Condition="Exists('$(_AliasDir)$(AssemblyName).exe')" />
		<Copy SourceFiles="$(_AliasDir)$(AssemblyName)"
		      DestinationFiles="$(_AliasDir)Relicade"
		      SkipUnchangedFiles="true"
		      Condition="Exists('$(_AliasDir)$(AssemblyName)') and !Exists('$(_AliasDir)$(AssemblyName).exe')" />
	</Target>
</Project>
